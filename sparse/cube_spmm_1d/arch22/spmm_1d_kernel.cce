#if __DAV_C220_CUBE__
extern "C" __global__ __aicore__ void SPMM_AIC_SYMBOL(SPMM_KERNEL_NAME)(
    int M,
    int N,
    int K,
    int vec_length,
    __gm__ __fp16 *values,
    __gm__ int *col_indices,
    __gm__ int *row_offsets,
    __gm__ __fp16 *B,
    __gm__ float *C,
    __gm__ void *ffts_addr,
    __gm__ __fp16 *workspace1,
    int64_t b_pack_slot_stride_elems,
    int64_t total_b_pack_elems,
    int64_t max_vectors_per_row,
    int64_t num_n_blocks,
    int64_t ldc,
    int64_t tiling_key
)
{
#if defined(SPMM_KERNEL_FAMILY_WORKSPACE)
    switch ((int32_t)tiling_key) {
#ifdef SPMM_NMAJOR_EXTENSIONS
        case SPMM_TILING_NMAJOR_57:
            nmajor_57::run_aic({M,N,K,vec_length,values,col_indices,row_offsets,B,C,
                ffts_addr,workspace1,b_pack_slot_stride_elems,total_b_pack_elems,
                max_vectors_per_row,num_n_blocks,ldc});
            break;
#endif
        case SPMM_TILING_WORKSPACE_AIC16_K128_BPACK512:
        case SPMM_TILING_AIVPP_AIC16_K128_BPACK512:
            workspace_aic16_k128_bpack512::run_aic({
                M, N, K, vec_length, values, col_indices, row_offsets, B, C,
                ffts_addr, workspace1, b_pack_slot_stride_elems, total_b_pack_elems,
                max_vectors_per_row, num_n_blocks, ldc});
            break;
        case SPMM_TILING_AIVPP_L0CPP_P32_AIC16_K128_BPACK512:
            workspace_aic16_k128_bpack512_l0cpp::run_aic({
                M, N, K, vec_length, values, col_indices, row_offsets, B, C,
                ffts_addr, workspace1, b_pack_slot_stride_elems, total_b_pack_elems,
                max_vectors_per_row, num_n_blocks, ldc});
            break;
        case SPMM_TILING_AIVPP_L0CPP_AIC32_K64_BPACK512:
        case SPMM_TILING_AIVPP_L0CPP_P32_AIC32_K64_BPACK512:
            workspace_aic32_k64_bpack512_l0cpp::run_aic({
                M, N, K, vec_length, values, col_indices, row_offsets, B, C,
                ffts_addr, workspace1, b_pack_slot_stride_elems, total_b_pack_elems,
                max_vectors_per_row, num_n_blocks, ldc});
            break;
        case SPMM_TILING_WORKSPACE_AIC16_K128_BPACK1024:
        case SPMM_TILING_AIVPP_AIC16_K128_BPACK1024:
            workspace_aic16_k128_bpack1024::run_aic({
                M, N, K, vec_length, values, col_indices, row_offsets, B, C,
                ffts_addr, workspace1, b_pack_slot_stride_elems, total_b_pack_elems,
                max_vectors_per_row, num_n_blocks, ldc});
            break;
        case SPMM_TILING_WORKSPACE_AIC8_K256_BPACK1024:
        case SPMM_TILING_AIVPP_AIC8_K256_BPACK1024:
            workspace_aic8_k256_bpack1024::run_aic({
                M, N, K, vec_length, values, col_indices, row_offsets, B, C,
                ffts_addr, workspace1, b_pack_slot_stride_elems, total_b_pack_elems,
                max_vectors_per_row, num_n_blocks, ldc});
            break;
        case SPMM_TILING_WORKSPACE_AIC4_K512_BPACK1024:
            workspace_aic4_k512_bpack1024::run_aic({
                M, N, K, vec_length, values, col_indices, row_offsets, B, C,
                ffts_addr, workspace1, b_pack_slot_stride_elems, total_b_pack_elems,
                max_vectors_per_row, num_n_blocks, ldc});
            break;
        case SPMM_TILING_WORKSPACE_AIC2_K1024_BPACK1024:
            workspace_aic2_k1024_bpack1024::run_aic({
                M, N, K, vec_length, values, col_indices, row_offsets, B, C,
                ffts_addr, workspace1, b_pack_slot_stride_elems, total_b_pack_elems,
                max_vectors_per_row, num_n_blocks, ldc});
            break;
        case SPMM_TILING_WORKSPACE_AIC1_K2048_BPACK1024:
            workspace_aic1_k2048_bpack1024::run_aic({
                M, N, K, vec_length, values, col_indices, row_offsets, B, C,
                ffts_addr, workspace1, b_pack_slot_stride_elems, total_b_pack_elems,
                max_vectors_per_row, num_n_blocks, ldc});
            break;
        case SPMM_TILING_AIVPP_AIC16_K128_BPACK2048:
            workspace_aic16_k128_bpack2048::run_aic({
                M, N, K, vec_length, values, col_indices, row_offsets, B, C,
                ffts_addr, workspace1, b_pack_slot_stride_elems, total_b_pack_elems,
                max_vectors_per_row, num_n_blocks, ldc});
            break;
        case SPMM_TILING_L0CPP_AIC32_K64_BPACK1024:
            workspace_aic32_k64_bpack1024_l0cpp::run_aic({
                M, N, K, vec_length, values, col_indices, row_offsets, B, C,
                ffts_addr, workspace1, b_pack_slot_stride_elems, total_b_pack_elems,
                max_vectors_per_row, num_n_blocks, ldc});
            break;
        case SPMM_TILING_AIVPP_L0CPP_AIC16_K128_BPACK1024:
        case SPMM_TILING_AIVPP_L0CPP_P32_AIC16_K128_BPACK1024:
            workspace_aic16_k128_bpack1024_l0cpp::run_aic({
                M, N, K, vec_length, values, col_indices, row_offsets, B, C,
                ffts_addr, workspace1, b_pack_slot_stride_elems, total_b_pack_elems,
                max_vectors_per_row, num_n_blocks, ldc});
            break;
        default:
            break;
    }
#else
#if SPMM_DIRECT_EXTENSIONS
    switch ((int32_t)tiling_key) {
        case SPMM_TILING_DIRECT_AIC32_K64_L0CPP:
            direct_aic32_k64_l0cpp::run_aic({
                M, N, K, vec_length, values, col_indices, row_offsets, B, C,
                ffts_addr, workspace1, b_pack_slot_stride_elems, total_b_pack_elems,
                max_vectors_per_row, num_n_blocks, ldc});
            break;
        case SPMM_TILING_DIRECT_AIC16_K128_L0CPP:
            direct_aic16_k128_l0cpp::run_aic({
                M, N, K, vec_length, values, col_indices, row_offsets, B, C,
                ffts_addr, workspace1, b_pack_slot_stride_elems, total_b_pack_elems,
                max_vectors_per_row, num_n_blocks, ldc});
            break;
        default: break;
    }
#else
            direct_aic64_k32::run_aic({
                M, N, K, vec_length, values, col_indices, row_offsets, B, C,
                ffts_addr, workspace1, b_pack_slot_stride_elems, total_b_pack_elems,
                max_vectors_per_row, num_n_blocks, ldc});
#endif
#endif
}
#endif  // __DAV_C220_CUBE__

